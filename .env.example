# Gemini
GEMINI_API_KEY=your-gemini-api-key

# Postgres (docker compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Host ports (differ from task-1 so both stacks can run side by side)
DB_PORT=5433
APP_PORT=3001

# Host-side dev (next dev, drizzle-kit); the compose app service builds its own URL pointing at db
DATABASE_URL=postgres://postgres:change-me@localhost:5433/app
